---
---

<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Carro de compras de Es Por Fé." />
		<link rel="icon" type="image/png" href="/brand/favicon-esporfe.png" />
		<title>Tu carro | Es Por Fé</title>
	</head>
	<body>
		<div class="announcement">Compra segura · Despachos en todo Chile</div>
		<header>
			<a class="brand" href="/" aria-label="Es Por Fé, inicio">
				<img src="/brand/logo-esporfe-transparent.png" alt="" width="1133" height="473" />
			</a>
			<a class="continue" href="/#catalogo">← Seguir comprando</a>
		</header>

		<main>
			<div class="heading">
				<p>Tu selección</p>
				<h1>Carro de compras</h1>
			</div>

			<div class="loading" data-loading>Cargando tu carro…</div>
			<section class="empty" data-empty hidden>
				<h2>Tu carro está vacío</h2>
				<p>Explora el catálogo y encuentra una Biblia para ti o para regalar.</p>
				<a class="button" href="/#catalogo">Ver productos</a>
			</section>

			<section class="cart-layout" data-cart hidden>
				<div class="items" data-items></div>
				<aside>
					<h2>Resumen</h2>
					<div class="summary-row"><span>Subtotal</span><strong data-subtotal></strong></div>
					<div class="summary-row muted"><span>Despacho</span><span>Se calcula en el checkout</span></div>
					<div class="summary-total"><span>Total parcial</span><strong data-total></strong></div>
					<a class="button" href="/checkout/">Continuar al checkout</a>
					<p>Precio con IVA incluido. Podrás revisar el despacho antes de confirmar.</p>
				</aside>
			</section>
			<p class="error" data-error role="alert"></p>
		</main>
	</body>
</html>

<style>
	:global(:root) { --ink:#351c31; --ink-soft:#66505f; --cream:#f7f2e9; --paper:#fffdf8; --pink:#c000a2; --gold:#ef8edb; --line:rgba(53,28,49,.18); font-family:Inter,Avenir,"Segoe UI",sans-serif; color:var(--ink); background:var(--cream); }
	:global(*) { box-sizing:border-box; }
	:global(body) { margin:0; }
	:global(a) { color:inherit; }
	:global([hidden]) { display:none !important; }
	.announcement { padding:.55rem 1rem; background:var(--ink); color:#fff; text-align:center; font-size:.72rem; letter-spacing:.09em; text-transform:uppercase; }
	header, main { width:min(calc(100% - 2.5rem), 1120px); margin:0 auto; }
	header { min-height:84px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); }
	.brand img { width:auto; height:2.5rem; display:block; }
	.continue { font-size:.78rem; font-weight:800; text-underline-offset:.3em; }
	main { padding:clamp(3rem,7vw,6rem) 0 7rem; }
	.heading { margin-bottom:3rem; }
	.heading p { margin:0 0 .75rem; color:var(--pink); font-size:.7rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
	h1,h2 { font-family:Georgia,serif; font-weight:500; }
	h1 { margin:0; font-size:clamp(2.8rem,6vw,5rem); letter-spacing:-.04em; }
	.loading,.empty { padding:3rem; background:var(--paper); text-align:center; }
	.empty h2 { margin-top:0; font-size:2rem; }
	.empty p { color:var(--ink-soft); }
	.cart-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(280px,360px); gap:clamp(2rem,6vw,5rem); align-items:start; }
	.items { border-top:1px solid var(--line); }
	:global(.cart-item) { display:grid; grid-template-columns:120px 1fr auto; gap:1.25rem; padding:1.4rem 0; border-bottom:1px solid var(--line); }
	:global(.cart-item img) { width:120px; height:120px; object-fit:contain; padding:.6rem; background:#eee7dc; }
	:global(.cart-item h2) { margin:.1rem 0 .4rem; font-size:1.2rem; line-height:1.3; }
	:global(.cart-item .sku) { margin:0 0 1rem; color:var(--ink-soft); font-size:.68rem; }
	:global(.item-controls) { display:flex; align-items:center; gap:.8rem; }
	:global(.item-controls input) { width:4rem; min-height:38px; border:1px solid var(--line); background:var(--paper); text-align:center; }
	:global(.remove) { border:0; padding:0; background:none; color:var(--ink-soft); font-size:.74rem; text-decoration:underline; cursor:pointer; }
	:global(.item-price) { font-weight:800; white-space:nowrap; }
	aside { position:sticky; top:2rem; padding:1.6rem; background:var(--paper); border:1px solid var(--line); }
	aside h2 { margin:0 0 1.5rem; font-size:1.7rem; }
	.summary-row,.summary-total { display:flex; justify-content:space-between; gap:1rem; padding:.8rem 0; font-size:.82rem; }
	.summary-row.muted { color:var(--ink-soft); border-bottom:1px solid var(--line); }
	.summary-total { margin-bottom:1rem; padding:1.2rem 0; font-size:1rem; }
	.button { min-height:52px; display:flex; align-items:center; justify-content:center; padding:.8rem 1.2rem; background:var(--ink); color:#fff; box-shadow:5px 5px 0 var(--gold); font-size:.8rem; font-weight:800; text-decoration:none; }
	aside p { margin:1.25rem 0 0; color:var(--ink-soft); font-size:.72rem; line-height:1.5; }
	.error { color:#9a1837; }
	@media(max-width:760px) { .cart-layout{grid-template-columns:1fr} aside{position:static} :global(.cart-item){grid-template-columns:88px 1fr} :global(.cart-item img){width:88px;height:88px} :global(.item-price){grid-column:2} }
	@media(max-width:520px) { header,main{width:min(calc(100% - 1.5rem),1120px)} .brand img{height:2.1rem} .continue{font-size:.7rem} }
</style>

<script>
	import {
		formatMoney,
		getCart,
		lineItemTotal,
		removeCartLineItem,
		type StoreCart,
		updateCartLineItem,
	} from "../lib/cart-client";

	const loading = document.querySelector<HTMLElement>("[data-loading]");
	const empty = document.querySelector<HTMLElement>("[data-empty]");
	const layout = document.querySelector<HTMLElement>("[data-cart]");
	const itemsElement = document.querySelector<HTMLElement>("[data-items]");
	const errorElement = document.querySelector<HTMLElement>("[data-error]");

	const escapeHtml = (value: string) => value.replace(/[&<>'"]/g, (character) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", "'":"&#39;", '"':"&quot;" })[character] ?? character);

	async function renderCart(updatedCart?: StoreCart) {
		if (errorElement) errorElement.textContent = "";
		const cart = updatedCart ?? await getCart();
		loading?.setAttribute("hidden", "");

		if (!cart?.items?.length) {
			itemsElement?.replaceChildren();
			empty?.removeAttribute("hidden");
			layout?.setAttribute("hidden", "");
			return;
		}

		empty?.setAttribute("hidden", "");
		layout?.removeAttribute("hidden");
		if (itemsElement) {
			itemsElement.innerHTML = cart.items.map((item) => `
				<article class="cart-item">
					<img src="${escapeHtml(item.thumbnail ?? "/favicon.svg")}" alt="" width="120" height="120">
					<div>
						<h2>${escapeHtml(item.product_title ?? item.title)}</h2>
						<p class="sku">SKU ${escapeHtml(item.variant_sku ?? "")}</p>
						<div class="item-controls">
							<label for="qty-${item.id}">Cantidad</label>
							<input id="qty-${item.id}" data-quantity="${item.id}" type="number" min="1" value="${item.quantity}">
							<button class="remove" data-remove="${item.id}" type="button">Eliminar</button>
						</div>
					</div>
					<strong class="item-price">${formatMoney(lineItemTotal(item))}</strong>
				</article>`).join("");
		}

		document.querySelector<HTMLElement>("[data-subtotal]")!.textContent = formatMoney(cart.subtotal);
		document.querySelector<HTMLElement>("[data-total]")!.textContent = formatMoney(cart.total);

		document.querySelectorAll<HTMLInputElement>("[data-quantity]").forEach((input) => input.addEventListener("change", async () => {
			input.disabled = true;
			try {
				const updatedCart = await updateCartLineItem(cart.id, input.dataset.quantity!, Math.max(1, Number(input.value)));
				await renderCart(updatedCart);
			}
			catch { if (errorElement) errorElement.textContent = "No pudimos actualizar la cantidad."; input.disabled = false; }
		}));

		document.querySelectorAll<HTMLButtonElement>("[data-remove]").forEach((button) => button.addEventListener("click", async () => {
			button.disabled = true;
			try {
				const updatedCart = await removeCartLineItem(cart.id, button.dataset.remove!);
				await renderCart(updatedCart);
			}
			catch { if (errorElement) errorElement.textContent = "No pudimos eliminar el producto."; button.disabled = false; }
		}));
	}

	void renderCart().catch(() => {
		loading?.setAttribute("hidden", "");
		if (errorElement) errorElement.textContent = "No pudimos cargar tu carro. Revisa que Medusa esté disponible.";
	});
</script>
