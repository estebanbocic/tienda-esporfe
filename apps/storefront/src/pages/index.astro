---
import { formatCLP, products } from "../data/products";

const featuredProducts = products.slice(0, 6);
const storyProduct = products.find((product) => product.sku === "133154") ?? products[0];

const steps = [
	{
		number: "01",
		title: "Encuentra tu Biblia",
		text: "Explora el catálogo y descubre una edición para tu camino de fe o para regalar.",
	},
	{
		number: "02",
		title: "Elige la indicada",
		text: "Revisa su traducción, formato, tamaño de letra y diseño de portada.",
	},
	{
		number: "03",
		title: "Recíbela en casa",
		text: "Preparamos tu pedido con dedicación y coordinamos el despacho dentro de Chile.",
	},
];
---

<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="Biblias y productos cristianos para acompañar tu fe, seleccionados con propósito por Es Por Fé."
		/>
		<meta name="theme-color" content="#f7f2e9" />
		<link rel="icon" type="image/png" href="/brand/favicon-esporfe.png" />
		<title>Es Por Fé | Biblias y productos cristianos con propósito</title>
	</head>
	<body>
		<a class="skip-link" href="#contenido">Ir al contenido</a>

		<div class="announcement">
			<p>Biblias y productos cristianos con propósito · Despachos en Chile</p>
		</div>

		<header class="site-header">
			<a class="brand" href="/" aria-label="Es Por Fé, inicio">
				<img class="brand-logo" src="/brand/logo-esporfe-transparent.png" alt="" width="1133" height="473" />
			</a>

			<nav aria-label="Navegación principal">
				<a href="#catalogo">Productos</a>
				<a href="#como-funciona">Cómo comprar</a>
				<a href="#historia">Nosotros</a>
			</nav>

			<a class="cart-link" href="/carro/" data-cart-link aria-label="Abrir carro, 0 productos">
				Carro <span data-cart-count>0</span>
			</a>
		</header>

		<main id="contenido">
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Fe para cada día</p>
					<h1>Palabra que inspira.<br /><em>Fe que acompaña.</em></h1>
					<p class="hero-text">
						Encuentra Biblias y productos cristianos escogidos para acompañar
						tu camino, fortalecer tu fe y regalar esperanza.
					</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#catalogo">Ver productos</a>
						<a class="text-link" href="#como-funciona">Descubre cómo funciona <span aria-hidden="true">↓</span></a>
					</div>
				</div>

				<div class="hero-art">
					<div class="sun" aria-hidden="true"></div>
					<figure class="hero-product-card">
						<img
							src={products[0].image}
							alt={products[0].title}
							width="1200"
							height="1200"
							fetchpriority="high"
						/>
						<figcaption>Con propósito</figcaption>
					</figure>
					<p class="art-note">Palabra para<br />cada etapa</p>
				</div>
			</section>

			<section class="values" aria-label="Beneficios">
				<p><span aria-hidden="true">✦</span> Fe para cada día</p>
				<p><span aria-hidden="true">♡</span> Regalos con propósito</p>
				<p><span aria-hidden="true">⌖</span> Despachos en Chile</p>
			</section>

			<section class="catalog" id="catalogo">
				<div class="section-heading">
					<div>
						<p class="eyebrow">Encuentra el tuyo</p>
						<h2>Biblias para cada historia</h2>
					</div>
				</div>

				<div class="product-grid">
					{featuredProducts.map((product) => (
						<article class="product-card">
							<a class="product-image" href={`/productos/${product.sku}/`} aria-label={`Ver ${product.title}`}>
								<img src={product.image} alt={product.title} width="1200" height="1200" loading="lazy" />
								{product.stock <= 2 && <span class="stock-badge">Últimas {product.stock} unidades</span>}
							</a>
							<p class="product-category">{product.category}</p>
							<h3>{product.title}</h3>
							<div class="product-meta">
								<strong>{formatCLP(product.price)}</strong>
								<span>SKU {product.sku}</span>
							</div>
							<a class="product-action" href={`/productos/${product.sku}/`}>
								Ver producto <span aria-hidden="true">→</span>
							</a>
						</article>
					))}
				</div>
				<div class="catalog-actions">
					<a class="button button-secondary" href="/productos/">
						Ver todos los productos <span aria-hidden="true">→</span>
					</a>
				</div>
			</section>

			<section class="process" id="como-funciona">
				<div class="process-intro">
					<p class="eyebrow">Simple y personal</p>
					<h2>Encuentra la Biblia que te acompañará</h2>
				</div>
				<ol class="steps">
					{steps.map((step) => (
						<li>
							<span class="step-number">{step.number}</span>
							<div>
								<h3>{step.title}</h3>
								<p>{step.text}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="story" id="historia">
				<div class="story-art">
					<div class="story-rays" aria-hidden="true"></div>
					<a class="story-product-card" href={`/productos/${storyProduct.sku}/`} aria-label={`Ver ${storyProduct.title}`}>
						<img src={storyProduct.image} alt={storyProduct.title} width="1200" height="1200" loading="lazy" />
					</a>
					<p class="story-note">Una palabra para<br />llevar contigo</p>
					<span class="story-caption">Salmos 51:10</span>
				</div>
				<div>
					<p class="eyebrow">Es Por Fé</p>
					<h2>La Palabra puede acompañar cada historia.</h2>
					<p>
						Creemos en Biblias que se leen, se comparten y se convierten en parte de la vida
						cotidiana. Elegimos cada edición pensando en distintos caminos y momentos de fe.
					</p>
					<a class="text-link" href="https://www.instagram.com/esporfetienda/" rel="noreferrer" target="_blank">
						Conócenos en Instagram <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>
		</main>

		<footer>
			<a class="brand brand-footer" href="/" aria-label="Es Por Fé, inicio">
				<img class="brand-logo" src="/brand/logo-esporfe-transparent.png" alt="" width="1133" height="473" loading="lazy" />
			</a>
			<p>Biblias y productos cristianos con propósito.</p>
			<a href="https://www.instagram.com/esporfetienda/" rel="noreferrer" target="_blank">@esporfetienda</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--ink: #351c31;
		--ink-soft: #66505f;
		--cream: #f7f2e9;
		--paper: #fffdf8;
		--sage: #e2bfdc;
		--sage-light: #f2ddeb;
		--terracotta: #c000a2;
		--gold: #ef8edb;
		--line: rgba(53, 28, 49, 0.18);
		--max-width: 1240px;
		font-family: Inter, Avenir, "Segoe UI", sans-serif;
		color: var(--ink);
		background: var(--cream);
		font-synthesis: none;
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body {
		margin: 0;
		background: radial-gradient(circle at 15% 6%, rgba(255, 255, 255, 0.9), transparent 25rem), var(--cream);
	}
	a { color: inherit; }
	p, h1, h2, h3 { margin-top: 0; }

	.skip-link {
		position: fixed; top: 0.75rem; left: 0.75rem; z-index: 20;
		padding: 0.75rem 1rem; background: var(--ink); color: white;
		transform: translateY(-160%);
	}
	.skip-link:focus { transform: translateY(0); }

	.announcement {
		padding: 0.55rem 1.25rem; background: var(--ink); color: #fff;
		text-align: center; font-size: 0.76rem; letter-spacing: 0.09em; text-transform: uppercase;
	}
	.announcement p { margin: 0; }

	.site-header {
		width: min(calc(100% - 2.5rem), var(--max-width)); min-height: 84px; margin: 0 auto;
		display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
		border-bottom: 1px solid var(--line);
	}
	.brand {
		width: fit-content; display: inline-flex; align-items: center; text-decoration: none;
	}
	.brand-logo { width: auto; height: 2.5rem; display: block; }
	nav { display: flex; gap: clamp(1.5rem, 4vw, 3.25rem); font-size: 0.82rem; font-weight: 650; }
	nav a, .cart-link { text-decoration: none; }
	nav a:hover, .cart-link:hover, footer a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
	.cart-link {
		justify-self: end; display: flex; align-items: center; gap: 0.55rem;
		font-size: 0.82rem; font-weight: 700;
	}
	.cart-link span {
		width: 1.55rem; aspect-ratio: 1; display: grid; place-items: center;
		border-radius: 50%; background: var(--terracotta); color: white; font-size: 0.7rem;
	}

	.hero {
		width: min(calc(100% - 2.5rem), var(--max-width)); min-height: 590px; margin: 0 auto;
		display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(430px, 1.18fr);
		gap: clamp(2.5rem, 6vw, 6rem); align-items: center; padding: clamp(3rem, 6vw, 5rem) 0;
	}
	.hero-copy { position: relative; z-index: 1; }
	.eyebrow {
		margin-bottom: 1.2rem; color: var(--terracotta); font-size: 0.72rem;
		font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase;
	}
	h1, h2 {
		font-family: Georgia, "Times New Roman", serif; font-weight: 500;
		line-height: 0.98; letter-spacing: -0.045em;
	}
	h1 { margin-bottom: 1.7rem; font-size: clamp(3.5rem, 7.5vw, 6.9rem); }
	h1 em { color: var(--terracotta); font-weight: 400; }
	.hero-text {
		max-width: 32rem; margin-bottom: 2.25rem; color: var(--ink-soft);
		font-size: clamp(1rem, 1.5vw, 1.14rem); line-height: 1.7;
	}
	.hero-actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
	.button {
		display: inline-flex; min-height: 52px; align-items: center; justify-content: center;
		padding: 0.7rem 1.5rem; font-size: 0.82rem; font-weight: 800; text-decoration: none;
	}
	.button-primary {
		background: var(--ink); color: #fff; box-shadow: 5px 5px 0 var(--gold);
		transition: transform 160ms ease, box-shadow 160ms ease;
	}
	.button-primary:hover { transform: translate(2px, 2px); box-shadow: 3px 3px 0 var(--gold); }
	.button-secondary { border: 1px solid var(--ink); transition: background-color 160ms ease, color 160ms ease; }
	.button-secondary:hover { background: var(--ink); color: white; }
	.text-link { font-size: 0.82rem; font-weight: 800; text-underline-offset: 0.35em; }

	.hero-art { position: relative; min-height: 432px; display: grid; place-items: center; isolation: isolate; }
	.hero-art::before {
		content: ""; position: absolute; inset: 1.5rem 7% 0; z-index: -2;
		border-radius: 50% 50% 8% 8%; background: var(--sage-light);
	}
	.sun {
		position: absolute; top: 1.5rem; right: 0; z-index: -3; width: 10.5rem; aspect-ratio: 1;
		border: 1px solid rgba(201, 111, 82, 0.45); border-radius: 50%;
		background: repeating-conic-gradient(from 4deg, transparent 0deg 7deg, rgba(201, 111, 82, 0.6) 8deg 8.5deg);
	}
	.hero-product-card {
		position: relative; width: min(76%, 29rem); height: 396px; margin: 0; padding: 0.85rem;
		background: var(--paper); box-shadow: 0 30px 70px rgba(32, 61, 55, 0.14);
		transform: rotate(2deg);
	}
	.hero-product-card img {
		width: 100%; height: 100%; display: block; object-fit: contain; background: #fff;
	}
	.hero-product-card figcaption {
		position: absolute; right: -1rem; bottom: -1rem; padding: 0.8rem 1rem;
		background: var(--ink); color: white; font-size: 0.85rem; font-weight: 800;
	}
	.art-note {
		position: absolute; bottom: 1.2rem; left: 0; margin: 0; padding: 0.9rem 1.1rem;
		background: var(--gold); font-family: Georgia, serif; font-size: 1.1rem;
		font-style: italic; line-height: 1.3; transform: rotate(-3deg);
	}

	.values {
		display: grid; grid-template-columns: repeat(3, 1fr); background: var(--paper);
		border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
	}
	.values p { margin: 0; padding: 1.6rem; text-align: center; font-family: Georgia, serif; font-size: 1rem; }
	.values p + p { border-left: 1px solid var(--line); }
	.values span { margin-right: 0.5rem; color: var(--terracotta); }

	.catalog, .process, .story {
		width: min(calc(100% - 2.5rem), var(--max-width)); margin: 0 auto;
		padding: clamp(5rem, 10vw, 9rem) 0;
	}
	.section-heading {
		margin-bottom: 3rem;
	}
	h2 { max-width: 22ch; margin-bottom: 0; font-size: clamp(2.19rem, 4.05vw, 3.81rem); }
	.section-heading > p, .story > div > p { margin: 0; color: var(--ink-soft); line-height: 1.7; }
	.product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem 1.25rem; }
	.product-card { min-width: 0; }
	.product-image {
		position: relative; overflow: hidden; margin-bottom: 1.2rem; aspect-ratio: 1;
		display: grid; place-items: center; padding: clamp(1.5rem, 3vw, 2.5rem); background: #eee7dc;
	}
	.product-image img {
		width: 100%; height: 100%; max-width: 280px; max-height: 280px; display: block; object-fit: contain;
		transition: transform 220ms ease;
	}
	.product-card:hover .product-image img { transform: scale(1.025); }
	.stock-badge {
		position: absolute; left: 0.75rem; bottom: 0.75rem; padding: 0.5rem 0.65rem;
		background: var(--paper); color: var(--terracotta); font-size: 0.68rem;
		font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase;
	}
	.product-category {
		margin-bottom: 0.6rem; color: var(--terracotta); font-size: 0.68rem;
		font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase;
	}
	.product-card h3 {
		min-height: 3.3rem; margin-bottom: 1rem; font-family: Georgia, serif;
		font-size: 1.25rem; font-weight: 500; line-height: 1.3;
	}
	.product-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
	.product-meta strong { font-size: 1rem; }
	.product-meta > span { color: var(--ink-soft); font-size: 0.66rem; }
	.product-action {
		display: flex; min-height: 46px; align-items: center; justify-content: space-between;
		margin-top: 1.1rem; padding: 0.7rem 1rem; border: 1px solid var(--ink);
		background: transparent; font-size: 0.76rem; font-weight: 800; text-decoration: none;
		transition: background-color 160ms ease, color 160ms ease;
	}
	.product-action:hover { background: var(--ink); color: white; }
	.catalog-actions { display: flex; justify-content: center; margin-top: 3rem; }
	.catalog-preview { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 1rem; }
	.preview-card {
		position: relative; min-height: 390px; overflow: hidden; display: flex;
		flex-direction: column; justify-content: space-between; padding: 1.5rem; background: var(--sage-light);
	}
	.preview-card-wide { background: #ebc9b9; }
	.preview-card-dark { background: var(--ink); color: white; }
	.preview-number { position: relative; z-index: 1; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; }
	.preview-card h3 {
		position: relative; z-index: 1; margin-bottom: 0.35rem;
		font-family: Georgia, serif; font-size: 1.4rem; font-weight: 500;
	}
	.preview-card p {
		position: relative; z-index: 1; margin: 0; font-size: 0.72rem;
		font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7;
	}
	.preview-shape {
		position: absolute; top: 17%; left: 50%; width: 52%; aspect-ratio: 0.82;
		border-radius: 48% 48% 16% 16%; background: var(--paper);
		box-shadow: 0 18px 50px rgba(32, 61, 55, 0.13); transform: translateX(-50%) rotate(-4deg);
	}
	.preview-shape::after {
		content: "✦"; position: absolute; inset: 0; display: grid; place-items: center;
		color: var(--terracotta); font-family: Georgia, serif; font-size: 3.5rem;
	}
	.preview-shape-two {
		width: 66%; aspect-ratio: 1; border-radius: 50%; background: #f6ead7;
		transform: translateX(-50%) rotate(7deg);
	}
	.preview-shape-two::after { content: "♡"; color: var(--gold); }
	.preview-shape-three {
		width: 55%; border-radius: 0.5rem 0.5rem 3rem 3rem; background: #d2b58a;
		transform: translateX(-50%) rotate(4deg);
	}
	.preview-shape-three::after { content: "✝"; color: var(--ink); }

	.process {
		display: grid; grid-template-columns: minmax(0, 0.75fr) minmax(340px, 1fr);
		gap: clamp(3rem, 9vw, 9rem); border-top: 1px solid var(--line);
	}
	.process-intro { align-self: start; position: sticky; top: 2rem; }
	.steps { margin: 0; padding: 0; list-style: none; }
	.steps li {
		display: grid; grid-template-columns: 3.5rem 1fr; gap: 1.5rem;
		padding: 0 0 2.2rem; border-bottom: 1px solid var(--line);
	}
	.steps li + li { padding-top: 2.2rem; }
	.step-number {
		width: 3rem; aspect-ratio: 1; display: grid; place-items: center;
		border: 1px solid var(--terracotta); border-radius: 50%;
		color: var(--terracotta); font-size: 0.72rem; font-weight: 800;
	}
	.steps h3 { margin-bottom: 0.65rem; font-family: Georgia, serif; font-size: 1.7rem; font-weight: 500; }
	.steps p { max-width: 35rem; margin: 0; color: var(--ink-soft); line-height: 1.65; }

	.story {
		display: grid; grid-template-columns: 0.75fr 1fr; gap: clamp(3rem, 8vw, 7rem);
		align-items: center; border-top: 1px solid var(--line);
	}
	.story-art { position: relative; min-height: 440px; display: grid; place-items: center; isolation: isolate; }
	.story-art::before {
		content: ""; position: absolute; inset: 2.5rem 8% 0; z-index: -2;
		border-radius: 48% 48% 10% 10%; background: var(--sage-light);
	}
	.story-rays {
		position: absolute; top: 0; right: 1%; z-index: -3; width: 10rem; aspect-ratio: 1;
		border: 1px solid rgba(192, 0, 162, 0.3); border-radius: 50%;
		background: repeating-conic-gradient(from 8deg, transparent 0deg 7deg, rgba(192, 0, 162, 0.42) 8deg 8.5deg);
	}
	.story-product-card {
		width: min(65%, 18rem); height: 390px; overflow: hidden; display: block; padding: .75rem;
		background: var(--paper); box-shadow: 0 28px 65px rgba(53, 28, 49, .18); transform: rotate(-2deg);
		transition: transform 180ms ease;
	}
	.story-product-card:hover { transform: rotate(-1deg) translateY(-3px); }
	.story-product-card img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center; }
	.story-note {
		position: absolute; left: 0; bottom: 1.4rem; margin: 0; padding: .9rem 1.1rem;
		background: var(--gold); font-family: Georgia, serif; font-size: 1.05rem;
		font-style: italic; line-height: 1.3; transform: rotate(3deg);
	}
	.story-caption {
		position: absolute; right: 2%; bottom: 3.2rem; padding: .7rem .9rem;
		background: var(--ink); color: white; font-size: .7rem; font-weight: 800; letter-spacing: .08em;
	}
	.story h2 { margin-bottom: 1.5rem; }
	.story .text-link { display: inline-block; margin-top: 1.7rem; }

	footer {
		min-height: 190px; display: grid; grid-template-columns: 1fr auto 1fr;
		align-items: center; gap: 2rem; padding: 2rem max(1.25rem, calc((100% - var(--max-width)) / 2));
		background: var(--ink); color: white;
	}
	.brand-footer { color: white; }
	.brand-footer .brand-logo { width: clamp(8.5rem, 13vw, 10.5rem); height: auto; }
	footer p { margin: 0; font-family: Georgia, serif; font-size: 1rem; font-style: italic; }
	footer > a:last-child { justify-self: end; font-size: 0.8rem; font-weight: 700; }

	@media (max-width: 860px) {
		.site-header { grid-template-columns: 1fr auto; }
		nav { display: none; }
		.hero { grid-template-columns: 1fr; gap: 2rem; padding-top: 4rem; }
		.hero-copy { max-width: 42rem; }
		.hero-art { min-height: 411px; }
		.section-heading, .process, .story { grid-template-columns: 1fr; }
		.catalog-preview { grid-template-columns: 1fr 1fr; }
		.product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.preview-card-wide { grid-column: span 2; }
		.process-intro { position: static; }
		footer { grid-template-columns: 1fr; padding-top: 3rem; padding-bottom: 3rem; text-align: center; }
		footer .brand, footer > a:last-child { justify-self: center; }
	}

	@media (max-width: 560px) {
		.site-header, .hero, .catalog, .process, .story { width: min(calc(100% - 1.5rem), var(--max-width)); }
		.site-header { min-height: 74px; }
		.brand-logo { width: auto; height: 2.15rem; }
		.hero { min-height: auto; padding-top: 3.5rem; }
		h1 { font-size: clamp(3.25rem, 17vw, 5rem); }
		.hero-art { min-height: 336px; }
		.hero-product-card { width: 76%; height: 312px; }
		.values { grid-template-columns: 1fr; }
		.values p + p { border-top: 1px solid var(--line); border-left: 0; }
		.section-heading { gap: 1.5rem; }
		.catalog-preview { grid-template-columns: 1fr; }
		.product-grid { grid-template-columns: 1fr; }
		.preview-card-wide { grid-column: auto; }
		.preview-card { min-height: 350px; }
