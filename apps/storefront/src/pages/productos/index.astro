---
import { formatCLP, products } from "../../data/products";

const categories = [...new Set(products.map((product) => product.category))];
---

<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Explora todos los productos disponibles en Es Por Fé." />
		<meta name="theme-color" content="#f7f2e9" />
		<link rel="icon" type="image/png" href="/brand/favicon-esporfe.png" />
		<title>Todos los productos | Es Por Fé</title>
	</head>
	<body>
		<div class="announcement">Biblias y productos cristianos con propósito · Despachos en Chile</div>
		<header>
			<a class="brand" href="/" aria-label="Es Por Fé, inicio">
				<img src="/brand/logo-esporfe-transparent.png" alt="" width="1133" height="473" />
			</a>
			<a class="back" href="/">← Volver al inicio</a>
			<a class="cart-link" href="/carro/" data-cart-link aria-label="Abrir carro, 0 productos">
				Carro <span data-cart-count>0</span>
			</a>
		</header>

		<main>
			<div class="heading">
				<p>Catálogo completo</p>
				<h1>Todos los productos</h1>
				<span data-product-count>{products.length} productos disponibles</span>
			</div>
			<div class="category-filters" role="group" aria-label="Filtrar productos por categoría">
				<button class="filter-bubble is-active" type="button" data-filter="all" aria-pressed="true">
					Todos <span>{products.length}</span>
				</button>
				{categories.map((category) => (
					<button class="filter-bubble" type="button" data-filter={category} aria-pressed="false">
						{category} <span>{products.filter((product) => product.category === category).length}</span>
					</button>
				))}
			</div>

			<div class="product-grid">
				{products.map((product) => (
					<article class="product-card" data-category={product.category}>
						<a class="product-image" href={`/productos/${product.sku}/`} aria-label={`Ver ${product.title}`}>
							<img src={product.image} alt={product.title} width="1200" height="1200" loading="lazy" />
							{product.stock <= 2 && <span class="stock-badge">Últimas {product.stock} unidades</span>}
						</a>
						<p class="category">{product.category}</p>
						<h2>{product.title}</h2>
						<div class="meta">
							<strong>{formatCLP(product.price)}</strong>
							<span>SKU {product.sku}</span>
						</div>
						<a class="product-action" href={`/productos/${product.sku}/`}>
							Ver producto <span aria-hidden="true">→</span>
						</a>
					</article>
				))}
			</div>
		</main>

		<footer>
			<p>Es Por Fé · Fe para cada día.</p>
			<a href="https://www.instagram.com/esporfetienda/" rel="noreferrer" target="_blank">@esporfetienda</a>
		</footer>
	</body>
</html>

<style>
	:global(:root) { --ink:#351c31; --ink-soft:#66505f; --cream:#f7f2e9; --paper:#fffdf8; --pink:#c000a2; --gold:#ef8edb; --line:rgba(53,28,49,.18); font-family:Inter,Avenir,"Segoe UI",sans-serif; color:var(--ink); background:var(--cream); }
	:global(*) { box-sizing:border-box; }
	:global(body) { margin:0; background:radial-gradient(circle at 15% 6%,rgba(255,255,255,.9),transparent 25rem),var(--cream); }
	:global(a) { color:inherit; }
	.announcement { padding:.55rem 1rem; background:var(--ink); color:white; text-align:center; font-size:.72rem; letter-spacing:.09em; text-transform:uppercase; }
	header,main { width:min(calc(100% - 2.5rem),1240px); margin:0 auto; }
	header { min-height:84px; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; border-bottom:1px solid var(--line); }
	.brand { width:fit-content; display:inline-flex; }
	.brand img { width:auto; height:2.5rem; display:block; }
	.back { font-size:.78rem; font-weight:800; text-underline-offset:.3em; }
	.cart-link { justify-self:end; display:flex; align-items:center; gap:.55rem; font-size:.82rem; font-weight:700; text-decoration:none; }
	.cart-link span { width:1.55rem; aspect-ratio:1; display:grid; place-items:center; border-radius:50%; background:var(--pink); color:white; font-size:.7rem; }
	main { padding:clamp(3.5rem,7vw,6rem) 0 7rem; }
	.heading { margin-bottom:3.5rem; }
	.heading p { margin:0 0 .8rem; color:var(--pink); font-size:.7rem; font-weight:800; letter-spacing:.16em; text-transform:uppercase; }
	h1,h2 { font-family:Georgia,"Times New Roman",serif; font-weight:500; }
	h1 { margin:0 0 1rem; font-size:clamp(3rem,6vw,5.5rem); line-height:1; letter-spacing:-.045em; }
	.heading > span { color:var(--ink-soft); font-size:.82rem; }
	.category-filters { display:flex; flex-wrap:wrap; gap:.7rem; margin:-1rem 0 3rem; }
	.filter-bubble { min-height:42px; padding:.65rem 1rem; border:1px solid var(--line); border-radius:999px; background:var(--paper); color:var(--ink); font:inherit; font-size:.76rem; font-weight:800; cursor:pointer; transition:background-color 160ms ease,border-color 160ms ease,color 160ms ease,transform 160ms ease; }
	.filter-bubble span { display:inline-grid; min-width:1.4rem; min-height:1.4rem; margin-left:.35rem; padding:0 .3rem; place-items:center; border-radius:999px; background:var(--cream); color:var(--ink-soft); font-size:.65rem; }
	.filter-bubble:hover { border-color:var(--pink); transform:translateY(-1px); }
	.filter-bubble:focus-visible { outline:3px solid rgba(192,0,162,.25); outline-offset:2px; }
	.filter-bubble.is-active { border-color:var(--ink); background:var(--ink); color:white; }
	.filter-bubble.is-active span { background:var(--pink); color:white; }
	.product-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:2.8rem 1.25rem; }
	.product-card { min-width:0; }
	.product-card[hidden] { display:none; }
	.product-image { position:relative; overflow:hidden; margin-bottom:1.2rem; aspect-ratio:1; display:grid; place-items:center; padding:clamp(1.5rem,3vw,2.5rem); background:#eee7dc; }
	.product-image img { width:100%; height:100%; max-width:280px; max-height:280px; display:block; object-fit:contain; transition:transform 220ms ease; }
	.product-card:hover .product-image img { transform:scale(1.025); }
	.stock-badge { position:absolute; left:.75rem; bottom:.75rem; padding:.5rem .65rem; background:var(--paper); color:var(--pink); font-size:.68rem; font-weight:800; letter-spacing:.04em; text-transform:uppercase; }
	.category { margin:0 0 .6rem; color:var(--pink); font-size:.68rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
	.product-card h2 { min-height:3.3rem; margin:0 0 1rem; font-size:1.25rem; line-height:1.3; }
	.meta { display:flex; align-items:baseline; justify-content:space-between; gap:1rem; }
	.meta strong { font-size:1rem; }
	.meta span { color:var(--ink-soft); font-size:.66rem; }
	.product-action { display:flex; min-height:46px; align-items:center; justify-content:space-between; margin-top:1.1rem; padding:.7rem 1rem; border:1px solid var(--ink); font-size:.76rem; font-weight:800; text-decoration:none; transition:background-color 160ms ease,color 160ms ease; }
	.product-action:hover { background:var(--ink); color:white; }
	footer { min-height:120px; display:flex; align-items:center; justify-content:space-between; gap:2rem; padding:2rem max(1.25rem,calc((100% - 1240px)/2)); background:var(--ink); color:white; }
	footer p { margin:0; font-family:Georgia,serif; font-style:italic; }
	footer a { font-size:.8rem; font-weight:700; }
	@media(max-width:860px) { .product-grid{grid-template-columns:repeat(2,minmax(0,1fr))} header{grid-template-columns:1fr auto}.back{display:none} }
	@media(max-width:560px) { header,main{width:min(calc(100% - 1.5rem),1240px)} header{min-height:74px}.brand img{height:2.15rem}.product-grid{grid-template-columns:1fr} footer{flex-direction:column;text-align:center} }
</style>

<script>
	import { initializeCartCount } from "../../lib/cart-client";

	initializeCartCount();

	const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
	const productCards = document.querySelectorAll<HTMLElement>("[data-category]");
	const productCount = document.querySelector<HTMLElement>("[data-product-count]");

	filterButtons.forEach((button) => {
		button.addEventListener("click", () => {
			const selectedCategory = button.dataset.filter;
			let visibleCount = 0;

			filterButtons.forEach((candidate) => {
				const isActive = candidate === button;
				candidate.classList.toggle("is-active", isActive);
				candidate.setAttribute("aria-pressed", String(isActive));
			});

			productCards.forEach((card) => {
				const isVisible = selectedCategory === "all" || card.dataset.category === selectedCategory;
				card.toggleAttribute("hidden", !isVisible);
				if (isVisible) visibleCount += 1;
			});

			if (productCount) {
				productCount.textContent = `${visibleCount} ${visibleCount === 1 ? "producto disponible" : "productos disponibles"}`;
			}
		});
	});
</script>
